public class TestMain {
    public static void main(String[] args) {
        // Khởi tạo các tam giác bằng 2 constructor khác nhau
        MyTriangle t1 = new MyTriangle(0, 0, 3, 0, 0, 4); // Tam giác vuông thường

        MyPoint p1 = new MyPoint(0, 0);
        MyPoint p2 = new MyPoint(4, 0);
        MyPoint p3 = new MyPoint(2, 3);
        MyTriangle t2 = new MyTriangle(p1, p2, p3); // Tam giác cân

        // In thông tin chuỗi toString()
        System.out.println("t1: " + t1);
        System.out.println("t2: " + t2);

        // In chu vi và loại tam giác
        System.out.printf("Chu vi t1: %.2f - Loai: %s%n", t1.getPerimeter(), t1.getType());
        System.out.printf("Chu vi t2: %.2f - Loai: %s%n", t2.getPerimeter(), t2.getType());
    }
}
