public class Author {
    String name;
    String email;
    public Author(String n,String e){
        name = n;
        email = e;
    }
    public String getName(){
        return name;
    }
    public String getEmail(){
        return email;

    }
    public void setEmail(String e){
        email = e;

    }
    public String toString(){
        return "Author[name=" + name + ",email=" + email + "]";

    }
}
